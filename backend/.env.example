# Copy this file to ".env" and adjust the values.
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
# medicore_dev matches the docker-compose.yml default; use your own for a local MySQL install
DB_PASSWORD=medicore_dev
DB_NAME=medicore

# JWT - use a long random string in production
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=8h
